# ── Free online DEMO configuration ─────────────────────────
# Copy these into your Hugging Face Space:
#   Settings → Variables and secrets → New secret / New variable
# (or use as .env on any prototype host)

# Neon Postgres — neon.tech → your project → "Connection string"
# ⚠ keep the ?sslmode=require parameter
DATABASE_URL="postgresql://user:password@ep-xxxxx.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# JWT signing secret — generate with:  openssl rand -hex 32
AUTH_SECRET=""

# Seed the Greek demo dataset automatically on first boot.
# ONLY seeds when the database has zero users — never wipes data.
DEMO_AUTOSEED="true"

# ── Optional / usually defaults ────────────────────────────
# PORT="3000"            # Hugging Face uses app_port from README.md
# HOSTNAME="0.0.0.0"
# NODE_ENV="production"
# APP_URL="https://your-space-url.hf.space"   # used in reset links
